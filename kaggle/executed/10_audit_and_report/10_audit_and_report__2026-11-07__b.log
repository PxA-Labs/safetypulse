,{"stream_name":"stdout","time":19923.005159713,"data":"# Paired bootstrap over prompts (negative ASR difference = first method safer): the pre-registered main\n"}
,{"stream_name":"stdout","time":19923.005164867,"data":"# method R1 against each alternative, and every method against the unrepaired drifted model.\n"}
,{"stream_name":"stdout","time":19923.005170509,"data":"def paired(name_a, name_b):\n"}
,{"stream_name":"stdout","time":19923.005175107,"data":"    A, B = aud[aud.model == name_a], aud[aud.model == name_b]\n"}
,{"stream_name":"stdout","time":19923.005179714,"data":"    out = []\n"}
,{"stream_name":"stdout","time":19923.005183925,"data":"    for metric in metrics:\n"}
,{"stream_name":"stdout","time":19923.005188477,"data":"        a, b = [], []\n"}
,{"stream_name":"stdout","time":19923.005192795,"data":"        for run in A.run:\n"}
,{"stream_name":"stdout","time":19923.005198987,"data":"            if run in set(B.run):\n"}
,{"stream_name":"stdout","time":19923.005206279,"data":"                a += A[A.run == run].flags.iloc[0][metric]\n"}
,{"stream_name":"stdout","time":19923.005209303,"data":"                b += B[B.run == run].flags.iloc[0][metric]\n"}
,{"stream_name":"stdout","time":19923.005212309,"data":"        if a:\n"}
,{"stream_name":"stdout","time":19923.005215322,"data":"            mean, lo, hi = sp.paired_bootstrap_diff(a, b)\n"}
,{"stream_name":"stdout","time":19923.005218775,"data":"            out.append({\"a\": name_a, \"b\": name_b, \"metric\": metric, \"a_minus_b\": mean, \"ci95\": [lo, hi]})\n"}
,{"stream_name":"stdout","time":19923.005237381,"data":"    return out\n"}
,{"stream_name":"stdout","time":19923.005242627,"data":"\n"}
,{"stream_name":"stdout","time":19923.005248115,"data":"repaired = [m for m in order[2:] if m != \"R5 random components\"] + sorted(aud[aud.method == \"R5 random components\"].model.unique())\n"}
,{"stream_name":"stdout","time":19923.005254379,"data":"comparisons = [x for m in repaired if m != \"R1 circuit restore\" for x in paired(\"R1 circuit restore\", m)]\n"}
,{"stream_name":"stdout","time":19923.005259475,"data":"comparisons += [x for m in repaired for x in paired(m, \"Drifted (R0)\")]\n"}
,{"stream_name":"stdout","time":19923.005264292,"data":"comp = pd.DataFrame(comparisons)\n"}
,{"stream_name":"stdout","time":19923.005268661,"data":"comp.to_csv(OUT / \"paired_comparisons.csv\", index=False)\n"}
,{"stream_name":"stdout","time":19923.005284503,"data":"comp[comp.metric == \"asr\"]\n"}
