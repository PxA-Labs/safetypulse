,{"stream_name":"stdout","time":15271.599244415,"data":"# Paired bootstrap over prompts (negative ASR difference = first method safer): the pre-registered main\n"}
,{"stream_name":"stdout","time":15271.599248753,"data":"# method R1 against each alternative, and every method against the unrepaired drifted model.\n"}
,{"stream_name":"stdout","time":15271.599253053,"data":"def paired(name_a, name_b):\n"}
,{"stream_name":"stdout","time":15271.59925733,"data":"    A, B = aud[aud.model == name_a], aud[aud.model == name_b]\n"}
,{"stream_name":"stdout","time":15271.599261774,"data":"    out = []\n"}
,{"stream_name":"stdout","time":15271.599266008,"data":"    for metric in metrics:\n"}
,{"stream_name":"stdout","time":15271.599270157,"data":"        a, b = [], []\n"}
,{"stream_name":"stdout","time":15271.599274487,"data":"        for run in A.run:\n"}
,{"stream_name":"stdout","time":15271.59927916,"data":"            if run in set(B.run):\n"}
,{"stream_name":"stdout","time":15271.59928315,"data":"                a += A[A.run == run].flags.iloc[0][metric]\n"}
,{"stream_name":"stdout","time":15271.599287305,"data":"                b += B[B.run == run].flags.iloc[0][metric]\n"}
,{"stream_name":"stdout","time":15271.599291443,"data":"        if a:\n"}
,{"stream_name":"stdout","time":15271.599295615,"data":"            mean, lo, hi = sp.paired_bootstrap_diff(a, b)\n"}
,{"stream_name":"stdout","time":15271.599299862,"data":"            out.append({\"a\": name_a, \"b\": name_b, \"metric\": metric, \"a_minus_b\": mean, \"ci95\": [lo, hi]})\n"}
,{"stream_name":"stdout","time":15271.599305184,"data":"    return out\n"}
,{"stream_name":"stdout","time":15271.599309803,"data":"\n"}
,{"stream_name":"stdout","time":15271.599314626,"data":"repaired = [m for m in order[2:] if m != \"R5 random components\"] + sorted(aud[aud.method == \"R5 random components\"].model.unique())\n"}
,{"stream_name":"stdout","time":15271.599319725,"data":"comparisons = [x for m in repaired if m != \"R1 circuit restore\" for x in paired(\"R1 circuit restore\", m)]\n"}
,{"stream_name":"stdout","time":15271.599324668,"data":"comparisons += [x for m in repaired for x in paired(m, \"Drifted (R0)\")]\n"}
,{"stream_name":"stdout","time":15271.599329085,"data":"comp = pd.DataFrame(comparisons)\n"}
,{"stream_name":"stdout","time":15271.599333666,"data":"comp.to_csv(OUT / \"paired_comparisons.csv\", index=False)\n"}
